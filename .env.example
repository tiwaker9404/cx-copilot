# ---- Service -------------------------------------------------------------
# dev = no auth required, docs on; prod = API keys required, docs off
CX_ENV=dev
# Comma-separated, at least 16 characters each. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
CX_API_KEYS=
# fake (offline) | ollama:<model> (free, local) | openai_compat:<model> | anthropic:<model> | openai:<model>
CX_MODEL=fake
# recommended free model, from real runs: ollama:qwen2.5:7b (needs ~16 GB RAM); ollama:llama3.2 for 8 GB
OLLAMA_BASE_URL=http://localhost:11434/v1
CX_DB_PATH=data/cx.db
# triage_v1 (model decides escalation) | triage_v2 (definitions + examples)
CX_TRIAGE_PROMPT=triage_v2
# model = trust the model's escalate flag | rules = decide from its labels in code
CX_ESCALATION=rules
# reply_v4_grounded only offers what the policy notes say (see README); reply_v1_baseline is the original
CX_REPLY_PROMPT=reply_v4_grounded
# off | risky (hold upset, urgent, follow-up or QA-flagged replies for a person) | all
CX_REVIEW_MODE=off
CX_CHECKPOINT_PATH=data/checkpoints.db
# keyword | bm25 | embed | hybrid ; embeddings are optional and free with Ollama
CX_RETRIEVAL=hybrid
# CX_EMBED_MODEL=ollama:nomic-embed-text
# CX_KB_PATH=examples/kb.northwind.json   # your own policies as JSON
CX_MAX_CONCURRENCY=2
CX_RATE_LIMIT_PER_MIN=60

# ---- LangSmith (free Developer plan: 5k traces/month, 14-day retention) --
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cx-copilot

# ---- Optional paid providers (not needed) --------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
